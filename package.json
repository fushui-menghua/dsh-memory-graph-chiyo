    "docs",
    "plugin.js",
    "cordis.patch.yml",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node test/demo.mjs",
    "cli": "node bin/cli.mjs",
    "bench": "node bin/bench.mjs",
    "test:plugin": "node test/plugin.test.mjs"
  },
  "keywords": [
    "ai-agent",
    "memory",
    "knowledge-graph",
    "long-term-memory",
    "anchors",
    "forgetting-curve",
    "consolidation",
